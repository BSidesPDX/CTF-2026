HASH="8af2ce63a6d1287ad368cd8bd1ef1de7d446255937f1203b20ee864bcfacb921"
TABLE_SIZE=1024
NUM_WORDS=6

token_factor() {
  local n=$1 i=2
  (( n < 2 )) && return 1
  while (( i * i <= n )); do
    (( n % i == 0 )) && return 1
    (( i++ ))
  done
  return 0
}

clamp_token_factor() {
  local n=$1
  (( n < 2 )) && n=2
  while ! token_factor "$n"; do (( n++ )); done
  printf '%s' "$n"
}

start=$(date +%s)
read -r -p "What enlightenment do you seek? " answer
end=$(date +%s)

delay=$(( end - start ))
base_factor=$(( RANDOM > start ))
factor=$(clamp_token_factor "$delay")

phrase=""
for (( k = 1; k <= NUM_WORDS; k++ )); do
  idx=$(( (factor * k) % TABLE_SIZE ))
  [ -n "$phrase" ] && phrase+=" "
  phrase+="${words[idx]}"
done

hash=$(printf '%s' "$phrase${answer:base_factor:base_factor}" | sha256sum | cut -d' ' -f1)

if [ "$hash" = "$HASH" ]; then
  printf 'pdx{%s}\n' "${phrase// /_}"
else
  printf '%s\n' "$phrase"
fi
