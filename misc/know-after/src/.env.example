# Copy to .env  (loaded automatically; .env is git-ignored)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...   # for the Jev decision model (monitor)

# SIP trunk (VoIP.ms sub-account); docker compose reads these for Asterisk
TRUNK_HOST=sanjose2.voip.ms
TRUNK_USER=
TRUNK_PASSWORD=
TRUNK_DID=
# TRUNK_EXTERNAL_ADDRESS=   # public IP advertised to the trunk; auto-detected when empty

# Deepgram (optional: stt.backend deepgram_flux / tts.backend deepgram_aura)
DEEPGRAM_API_KEY=
# DigitalOcean serverless inference model access key (tts.backend: digitalocean)
DIGITALOCEAN_API_KEY=
