# Admin shizzle, set to dumb
PG_SUPERUSER=pgadmin
PG_SUPERPASS=change_me_now

PG_DB=bsides

# App database user (now owns the schema)
APP_SCHEMA=app
APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_DB_NAME=bsides
APP_USER=myapp_user
APP_USER_PASS=app_password_change_me

# App secrets set to something random
JWT_SECRET=invalidate-me-daddy
SESSION_SECRET=some-goth-stompers
SESSION_MAX_AGE_HOURS=72

# Application Configuration
NODE_ENV=development
PORT=3000
HOST_PORT=3000
# Optional comma-separated origins for cross-origin API clients. Same-origin pages do not need this.
CORS_ORIGIN=
