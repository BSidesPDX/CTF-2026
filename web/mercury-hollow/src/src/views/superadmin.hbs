{{> head pageTitle=title customStyles="
        .command-toolbar {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .command-id { margin: 0; color: var(--muted); font-family: var(--mono); font-size: 0.82rem; }
        .command-status { display: flex; gap: 0.45rem; flex-wrap: wrap; }
        .command-layout {
            display: grid;
            grid-template-columns: minmax(0, 1.6fr) minmax(270px, 0.8fr);
            gap: 1.25rem;
            align-items: start;
        }
        .section-label {
            display: block;
            margin-bottom: 0.35rem;
            color: var(--muted);
            font-size: 0.68rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }
        .metric-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 0.75rem;
            margin-bottom: 1.25rem;
        }
        .metric {
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 0.9rem;
            background: var(--card);
            box-shadow: var(--shadow);
        }
        .metric span { display: block; color: var(--muted); font-size: 0.64rem; letter-spacing: 0.09em; text-transform: uppercase; }
        .metric strong { display: block; margin-top: 0.25rem; color: var(--ink); font-size: 0.94rem; }
        .metric strong.ok { color: var(--ok-text); }
        .metric strong.hold { color: var(--warn-text); }
        .document-file {
            display: grid;
            grid-template-columns: 48px minmax(0, 1fr) auto;
            align-items: center;
            gap: 1rem;
            margin: 1rem 0 1.2rem;
            padding: 1rem;
            border: 1px solid var(--line);
            border-radius: 10px;
            background: #fbfaf7;
        }
        .pdf-mark {
            width: 48px;
            height: 54px;
            display: grid;
            place-items: center;
            border-radius: 6px;
            background: #f5dfdc;
            color: #8f2e28;
            font-family: var(--mono);
            font-size: 0.68rem;
            font-weight: 700;
        }
        .document-copy { min-width: 0; }
        .document-copy strong { display: block; color: var(--ink); font-family: var(--mono); font-size: 0.88rem; overflow-wrap: anywhere; }
        .document-copy span { display: block; color: var(--muted); font-size: 0.75rem; }
        .metadata-list { border-top: 1px solid var(--line); }
        .metadata-row {
            display: grid;
            grid-template-columns: minmax(125px, 0.65fr) minmax(0, 1.35fr);
            gap: 1rem;
            padding: 0.7rem 0;
            border-bottom: 1px solid var(--line);
            font-size: 0.84rem;
        }
        .metadata-row span:first-child { color: var(--muted); }
        .metadata-row code { padding: 0; border: 0; background: none; color: var(--ink); text-align: right; }
        .event-list { list-style: none; padding: 0; margin: 0.85rem 0 0; }
        .event-list li {
            display: grid;
            grid-template-columns: 62px minmax(0, 1fr);
            gap: 0.8rem;
            padding: 0.7rem 0;
            border-bottom: 1px solid var(--line);
        }
        .event-list time { color: var(--muted); font-family: var(--mono); font-size: 0.72rem; }
        .event-list strong { display: block; color: var(--ink); font-size: 0.82rem; }
        .event-list span { display: block; color: var(--muted); font-size: 0.75rem; }
        .vault-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem; margin-top: 0.8rem; }
        .vault-field { border: 1px solid var(--line); border-radius: 8px; padding: 0.7rem; background: #fbfaf7; }
        .vault-field span { display: block; color: var(--muted); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; }
        .vault-field code { display: block; padding: 0.2rem 0 0; border: 0; background: none; color: var(--ink); }
        .policy-note {
            margin-top: 1rem;
            padding: 0.8rem 0.9rem;
            border-left: 3px solid #96382f;
            background: #f8eae8;
            color: #70312b;
            font-size: 0.78rem;
        }
        @media (max-width: 820px) {
            .metric-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .command-layout { grid-template-columns: 1fr; }
        }
        @media (max-width: 560px) {
            .metric-grid { grid-template-columns: 1fr; }
            .document-file { grid-template-columns: 48px minmax(0, 1fr); }
            .document-file .button { grid-column: 1 / -1; width: 100%; }
            .metadata-row { grid-template-columns: 1fr; gap: 0.15rem; }
            .metadata-row code { text-align: left; }
        }
"}}
<body>
    {{> company-header subtitle="Emergency Operations Control Plane"}}
    <main class="page" style="max-width: 1080px;">
        <div class="page-head command-toolbar">
            <div>
                <span class="kicker">Incident Command / Level 0</span>
                <h1>{{facilityName}} Emergency Control</h1>
                <p class="command-id">Privileged session · Control node BR-EC-01</p>
            </div>
            <div class="command-status">
                <span class="chip chip-active">Containment Active</span>
                <span class="chip chip-ok">Privileged Session</span>
            </div>
        </div>

        <div class="flag">
            <span class="flag-caption">Emergency Authorization Token</span>
            {{flag}}
        </div>

        <div class="metric-grid">
            <div class="metric"><span>Containment</span><strong class="ok">STABLE</strong></div>
            <div class="metric"><span>Field Units</span><strong>03 ACTIVE</strong></div>
            <div class="metric"><span>Records Hold</span><strong class="hold">ENFORCED</strong></div>
            <div class="metric"><span>Last Update</span><strong>04:27 PDT</strong></div>
        </div>

        <div class="command-layout">
            <section>
                <div class="card">
                    <span class="section-label">Document Control</span>
                    <h2>Final Remediation Report</h2>
                    <p>Approved closure package retained under the legacy emergency export profile.</p>

                    <div class="document-file">
                        <div class="pdf-mark">PDF</div>
                        <div class="document-copy">
                            <strong>final-remediation-report.pdf</strong>
                            <span>Approved record · Document Control · Original export</span>
                        </div>
                        <a class="button" href="/challenge-downloads/final-remediation-report.pdf">Download Export</a>
                    </div>

                    <div class="metadata-list">
                        <div class="metadata-row">
                            <span>Document identifier</span>
                            <code>SEALED UNTIL EXPORT</code>
                        </div>
                        <div class="metadata-row">
                            <span>Classification</span>
                            <code>RESTRICTED / LEGACY</code>
                        </div>
                        <div class="metadata-row">
                            <span>Export profile</span>
                            <code>VLT-3 / PRESERVE</code>
                        </div>
                        <div class="metadata-row">
                            <span>Integrity state</span>
                            <code>SEALED</code>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <span class="section-label">Control Activity</span>
                    <h2>Export Event History</h2>
                    <ul class="event-list">
                        <li>
                            <time>04:11</time>
                            <div><strong>Closure package approved</strong><span>Emergency authority M. Voss</span></div>
                        </li>
                        <li>
                            <time>04:16</time>
                            <div><strong>Legacy vault profile applied</strong><span>Document Control VLT-3</span></div>
                        </li>
                        <li>
                            <time>04:19</time>
                            <div><strong>Classification fields retained</strong><span>Metadata normalization bypassed under records hold</span></div>
                        </li>
                        <li>
                            <time>04:27</time>
                            <div><strong>Final export sealed</strong><span>Original object released to privileged session</span></div>
                        </li>
                    </ul>
                </div>
            </section>

            <aside>
                <div class="card">
                    <span class="section-label">Vault Profile</span>
                    <h2>VLT-3 Legacy Control</h2>
                    <div class="vault-grid">
                        <div class="vault-field">
                            <span>Segment 01 source</span>
                            <code>INCIDENT.CONSTITUENT</code>
                        </div>
                        <div class="vault-field">
                            <span>Segment 02 source</span>
                            <code>ARCHIVE.BATCH_FAMILY</code>
                        </div>
                        <div class="vault-field">
                            <span>Segment 03 source</span>
                            <code>CUSTODY.PACKET_SUFFIX</code>
                        </div>
                        <div class="vault-field">
                            <span>Transform</span>
                            <code>LOWERCASE</code>
                        </div>
                        <div class="vault-field">
                            <span>Separator</span>
                            <code>0x2D</code>
                        </div>
                        <div class="vault-field">
                            <span>Escrow</span>
                            <code>DETACHED</code>
                        </div>
                    </div>
                    <div class="policy-note">VLT-3 resolves source values at export time. Resolved material is not retained in the control-plane record.</div>
                </div>

                <div class="card">
                    <span class="section-label">Incident Status</span>
                    <h2>Active Containment Record</h2>
                    <div class="metadata-list">
                        <div class="metadata-row">
                            <span>Facility</span>
                            <code>{{facilityName}}</code>
                        </div>
                        <div class="metadata-row">
                            <span>Docket source</span>
                            <code>PUBLIC INCIDENT RECORD</code>
                        </div>
                        <div class="metadata-row">
                            <span>Command state</span>
                            <code>MONITORING</code>
                        </div>
                    </div>
                </div>
            </aside>
        </div>

        <div class="links">
            <a href="/archive">Records Vault</a>
            <a href="/incident">Incident Bulletin</a>
        </div>
    </main>
    {{> footer}}
</body>
</html>
