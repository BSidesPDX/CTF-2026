<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if pageTitle}}{{pageTitle}} · {{/if}}Ellingson Mineral Corporation</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }

        :root {
            --ink: #0b1926;
            --ink-2: #122a3f;
            --surface: #f4f2ed;
            --card: #ffffff;
            --line: #e4ded3;
            --sand: #efe9dd;
            --text: #243039;
            --muted: #6a7581;
            --copper: #b95419;
            --copper-dark: #97430f;
            --gold: #dfa561;
            --ok-text: #17663c; --ok-bg: #e9f6ee; --ok-line: #c2e3cf;
            --err-text: #a83226; --err-bg: #fceeec; --err-line: #f0c9c4;
            --warn-text: #8a5a12; --warn-bg: #fcf3e2; --warn-line: #eedbb4;
            --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace;
            --radius: 12px;
            --shadow: 0 1px 2px rgba(11, 25, 38, 0.05), 0 10px 30px rgba(11, 25, 38, 0.07);
        }

        html { scroll-behavior: smooth; }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-family: var(--sans);
            font-size: 16px;
            line-height: 1.6;
            color: var(--text);
            background: var(--surface);
            -webkit-font-smoothing: antialiased;
        }

        h1, h2, h3 { line-height: 1.25; color: var(--ink); margin: 0 0 0.75rem; letter-spacing: -0.01em; }
        h1 { font-size: 1.8rem; font-weight: 700; }
        h2 { font-size: 1.15rem; font-weight: 600; }
        h3 { font-size: 1rem; font-weight: 600; }
        p { margin: 0 0 1rem; }
        p:last-child { margin-bottom: 0; }
        a { color: var(--copper); }
        img { max-width: 100%; display: block; }

        code {
            font-family: var(--mono);
            font-size: 0.88em;
            background: var(--sand);
            border: 1px solid var(--line);
            border-radius: 6px;
            padding: 0.1em 0.4em;
            word-break: break-all;
        }

        .kicker {
            display: block;
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--copper);
            margin-bottom: 0.5rem;
        }

        /* ── Site header ─────────────────────────────── */
        .site-header {
            background: linear-gradient(120deg, var(--ink) 0%, var(--ink-2) 100%);
            border-bottom: 3px solid var(--copper);
            color: #eef3f7;
            padding: 0.85rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .brand { display: inline-flex; align-items: center; gap: 0.7rem; text-decoration: none; color: inherit; }
        .brand-mark { width: 34px; height: 34px; flex: none; }
        .brand-name { display: block; font-size: 0.95rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #fff; line-height: 1.25; }
        .brand-tag { display: block; font-size: 0.6rem; font-weight: 600; letter-spacing: 0.32em; text-transform: uppercase; color: var(--gold); line-height: 1.25; }
        .header-division {
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #9db0c2;
            border: 1px solid rgba(157, 176, 194, 0.35);
            border-radius: 999px;
            padding: 0.28rem 0.85rem;
            white-space: nowrap;
        }

        /* ── Layout ──────────────────────────────────── */
        .page { flex: 1; width: 100%; max-width: 1080px; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
        .page-narrow { max-width: 480px; }
        .page-wide { max-width: 1200px; }
        .page-center { display: flex; flex-direction: column; justify-content: center; }
        .page-head { margin-bottom: 1.75rem; }
        .page-head h1 { margin-bottom: 0.35rem; }
        .page-lead { color: var(--muted); max-width: 65ch; margin: 0; }

        /* ── Cards ───────────────────────────────────── */
        .card {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 1.6rem 1.75rem;
            margin-bottom: 1.25rem;
        }
        .callout { border-left: 4px solid var(--copper); }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1rem;
            margin-bottom: 1.25rem;
        }
        .stat { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.25rem; }
        .stat-label { display: block; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.3rem; }
        .stat-value { font-family: var(--mono); font-size: 0.95rem; color: var(--ink); word-break: break-all; }

        /* ── Forms ───────────────────────────────────── */
        .form-group { margin-bottom: 1.15rem; }
        label { display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem; color: var(--ink); }
        input, select {
            width: 100%;
            padding: 0.65rem 0.85rem;
            font: inherit;
            color: var(--text);
            background: #fff;
            border: 1px solid #d6cfc2;
            border-radius: 8px;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        input:focus, select:focus {
            outline: none;
            border-color: var(--copper);
            box-shadow: 0 0 0 3px rgba(185, 84, 25, 0.14);
        }

        button, .button {
            display: inline-block;
            font: inherit;
            font-weight: 600;
            color: #fff;
            background: var(--copper);
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 0.6rem 1.25rem;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            transition: background 0.15s, border-color 0.15s;
        }
        button:hover, .button:hover { background: var(--copper-dark); }
        .button-secondary { color: var(--ink); background: transparent; border-color: #cfc7b9; }
        .button-secondary:hover { background: var(--sand); }

        /* ── Auth card ───────────────────────────────── */
        .auth-card { padding: 2.25rem 2rem 2rem; margin-bottom: 1rem; }
        .auth-card .kicker { margin-bottom: 0.3rem; }
        .auth-card h1 { font-size: 1.4rem; margin-bottom: 1.25rem; }
        .auth-card button[type='submit'] { width: 100%; padding: 0.75rem; margin-top: 0.4rem; }

        /* ── Alerts ──────────────────────────────────── */
        .error, .success, .security-notice {
            border: 1px solid;
            border-radius: 8px;
            padding: 0.7rem 1rem;
            font-size: 0.9rem;
            margin-bottom: 1.1rem;
        }
        .error { background: var(--err-bg); border-color: var(--err-line); color: var(--err-text); }
        .success { background: var(--ok-bg); border-color: var(--ok-line); color: var(--ok-text); }
        .security-notice { background: var(--warn-bg); border-color: var(--warn-line); color: var(--warn-text); text-align: center; font-weight: 600; }

        /* ── Flag / terminal block ───────────────────── */
        .flag {
            background: var(--ink);
            border: 1px solid #24425c;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            color: #7ce6a1;
            font-family: var(--mono);
            font-size: 1rem;
            padding: 1.1rem 1.3rem;
            margin-bottom: 1.25rem;
            word-break: break-all;
        }
        .flag-caption {
            display: block;
            font-family: var(--sans);
            font-size: 0.66rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #6f8ba3;
            margin-bottom: 0.4rem;
        }

        /* ── Chips ───────────────────────────────────── */
        .chip {
            display: inline-block;
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            border-radius: 999px;
            padding: 0.28rem 0.8rem;
            vertical-align: middle;
        }
        .chip-active { background: var(--warn-bg); color: var(--warn-text); border: 1px solid var(--warn-line); }
        .chip-ok { background: var(--ok-bg); color: var(--ok-text); border: 1px solid var(--ok-line); }

        /* ── Link rows ───────────────────────────────── */
        .links { text-align: center; margin-top: 1.5rem; font-size: 0.9rem; }
        .links a { color: var(--muted); text-decoration: none; margin: 0 0.75rem; }
        .links a:hover { color: var(--copper); text-decoration: underline; }

        /* ── User management (admin) ─────────────────── */
        .user-list { display: grid; gap: 0.75rem; }
        .user-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            flex-wrap: wrap;
            background: #fbfaf7;
            border: 1px solid var(--line);
            border-radius: 10px;
            padding: 0.85rem 1.1rem;
        }
        .user-info { flex: 1; min-width: 180px; }
        .user-name { font-family: var(--mono); font-weight: 600; color: var(--ink); }
        .user-permission { font-size: 0.82rem; color: var(--muted); }
        .permission-controls select { width: auto; padding: 0.45rem 0.7rem; font-size: 0.88rem; }
        .permission-controls button { padding: 0.48rem 0.9rem; font-size: 0.85rem; }

        /* ── Footer ──────────────────────────────────── */
        .footer {
            margin-top: auto;
            border-top: 1px solid var(--line);
            padding: 1.4rem 1.5rem;
            text-align: center;
            font-size: 0.8rem;
            color: var(--muted);
        }

        @media (max-width: 640px) {
            .site-header { justify-content: center; text-align: center; }
            .page { padding: 1.75rem 1.1rem 3rem; }
            h1 { font-size: 1.45rem; }
        }

        {{#if customStyles}}{{{customStyles}}}{{/if}}
    </style>
    {{#if customHead}}{{{customHead}}}{{/if}}
</head>
