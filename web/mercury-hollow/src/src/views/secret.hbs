{{> head pageTitle="Corporate Portal" customStyles="
        .portal-card { text-align: center; padding: 2.5rem 2.25rem; }
        .welcome { font-size: 1.15rem; margin-bottom: 0.75rem; }
        .permission-badge {
            display: inline-block;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--ink);
            background: var(--sand);
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 0.3rem 0.9rem;
            margin-bottom: 1.75rem;
        }
        .flag-panel { text-align: left; margin: 0 0 1.5rem; }
        .access-denied {
            background: var(--err-bg);
            border: 1px solid var(--err-line);
            border-radius: 8px;
            color: var(--err-text);
            font-weight: 600;
            padding: 0.9rem 1rem;
            margin-bottom: 1.5rem;
        }
        .portal-actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
" customHead="
    <script>
        function accessAdmin() {
            // Make a request to admin with credentials (cookies) included
            fetch('/admin', {
                method: 'GET',
                credentials: 'include',  // This ensures cookies are sent with the request
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (response.ok) {
                    // If successful, redirect to admin page
                    window.location.href = '/admin';
                } else {
                    alert('Access denied. You need superuser permissions.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error accessing admin panel');
            });
        }
    </script>
"}}
<body>
    {{> company-header subtitle="Corporate Portal"}}
    <main class="page page-center" style="max-width: 640px;">
        <div class="card portal-card">
            <span class="kicker">Corporate Information Portal</span>
            <h1>Corporate Portal Access</h1>

            <div class="welcome">
                Welcome, <strong>{{user.teamName}}</strong>
            </div>

            <div class="permission-badge">
                Access Level: {{user.permission}}
            </div>

            {{#if flag}}
            <div class="flag flag-panel">
                <span class="flag-caption">Classified Information</span>
                {{flag}}
            </div>
            {{else}}
            <div class="access-denied">
                Access restricted — administrative clearance is required to view classified information.
            </div>
            {{/if}}

            <div class="portal-actions">
                {{#if user.isSuperuser}}
                <a href="#" class="button" onclick="accessAdmin()">Administrative Panel</a>
                {{/if}}
                <a href="/logout" class="button button-secondary">Logout</a>
            </div>
        </div>
    </main>
    {{> footer}}
</body>
</html>
